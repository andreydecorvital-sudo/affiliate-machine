NODE_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — provider de IA principal
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Shopee Affiliate
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=
SHOPEE_AFFILIATE_GRAPHQL_URL=https://open-api.affiliate.shopee.com.br/graphql

# Meta Ads — read-only
# A versão é obrigatória e nunca é inferida pelo código.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_GRAPH_API_VERSION=
META_GRAPH_BASE_URL=https://graph.facebook.com

# Reservado para futura configuração OAuth/app; não usado pelo sync atual.
META_APP_ID=
META_APP_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
INTERNAL_JOB_SECRET=

# Safety gates — todos OFF por padrão
AUTOPILOT_ENABLED=0
WHATSAPP_REAL_SEND_ENABLED=0
META_ADS_WRITE_ENABLED=0
